platform/MacOS/MTEngineSDLDummyApp.xcodeproj/project.xcworkspace/xcuserdata/
# Personal Xcode state, wherever it sits: breakpoints, navigator scopes, window
# layout. The SHARED scheme under xcshareddata/ is tracked deliberately -- it is
# what lets someone else open this project and build it with -scheme, which the
# capability pre-action requires -- but everything under xcuserdata/ belongs to
# one machine and two such files had been tracked here.
xcuserdata/
platform/MacOS/MTEngineSDLDummyApp.xcodeproj/project.xcworkspace/xcshareddata/
platform/MacOS/MTEngineSDLDummyApp.xcodeproj/project.xcworkspace/xcshareddata/MTEngineSDL.xccheckout
platform/MacOS/MTEngineSDLDummyApp.xcodeproj/.idea/
platform/MacOS/DerivedData/
platform/MacOS/build/
platform/Windows/.vs/
platform/Windows/bin/
platform/Windows/prod/
platform/Windows/MTEngineSDLDummyApp/x64/
platform/Windows/MTEngineSDLDummyApp/Win32/
platform/Windows/MTEngineSDLDummyApp/ARM64/
*.vcxproj.user
tools/DeployMaker_v1.0/Debug/
bmfont2slrfont/Debug/
Debug/
core.*
core
*~
tests/results/
.worktrees/
